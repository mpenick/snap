; The standard library. The Makefile builds it into snap as a string, and
; snap_init() runs it.

; (defn name [param...] body...) defines a function
(defmacro defn [name params & body]
  `(def ~name (fn ~params ~@body)))

; (defconst name expr) defines a global that can't change. Code compiled after
; it uses the value itself in place of the global, so arithmetic can read it
; like a literal.
(defmacro defconst [name val] `(set-const! '~name ~val))

(defmacro when [c & body] `(if ~c (begin ~@body) nil))

; (cond test1 expr1 test2 expr2...) is the expr of the first true test, or nil
(defmacro cond [& clauses]
  (if (= (count clauses) 0) nil
    `(if ~(first clauses) ~(nth clauses 1) (cond ~@(rest (rest clauses))))))

; (dotimes [i n] body...) runs body with i from 0 to n - 1
(defmacro dotimes [binding & body]
  (let [i (nth binding 0) n (gensym)]
    `(let [~n ~(nth binding 1)]
       (loop [~i 0] (if (< ~i ~n) (begin ~@body (recur (+ ~i 1))) nil)))))

; (doseq [x coll] body...) runs body with x as each item of a vector or list
(defmacro doseq [binding & body]
  (let [x (nth binding 0) v (gensym) i (gensym)]
    `(let [~v ~(nth binding 1) ~v (if (vector? ~v) ~v (vec ~v))]
       (dotimes [~i (count ~v)] (let [~x (nth ~v ~i)] ~@body)))))

(defn inc [x] (+ x 1))
(defn dec [x] (- x 1))

; map, filter and reduce take a vector or list and make a vector
(defn map [f coll]
  (let [v (if (vector? coll) coll (vec coll)) n (count v) out []]
    (loop [i 0] (if (< i n) (begin (push! out (f (nth v i))) (recur (+ i 1))) out))))

(defn filter [f coll]
  (let [v (if (vector? coll) coll (vec coll)) n (count v) out []]
    (loop [i 0]
      (if (< i n)
        (let [x (nth v i)] (if (f x) (push! out x) nil) (recur (+ i 1)))
        out))))

(defn reduce [f init coll]
  (let [v (if (vector? coll) coll (vec coll)) n (count v)]
    (loop [acc init i 0] (if (< i n) (recur (f acc (nth v i)) (+ i 1)) acc))))

; (sort-by key coll) is a vector of coll's items ordered by (key item),
; smallest first. Items with equal keys keep their order (a bottom-up merge
; sort).
(defn sort-by [key coll]
  (let [n (count coll) a (map (fn [x] [(key x) x]) coll) b (map (fn [x] x) a)]
    (loop [width 1 src a dst b]
      (if (< width n)
        (begin
          (loop [lo 0]
            (when (< lo n)
              (let [mid (min (+ lo width) n) hi (min (+ mid width) n)]
                (loop [i lo j mid k lo]
                  (when (< k hi)
                    (if (and (< i mid) (or (>= j hi) (<= (nth (nth src i) 0) (nth (nth src j) 0))))
                      (begin (put! dst k (nth src i)) (recur (+ i 1) j (+ k 1)))
                      (begin (put! dst k (nth src j)) (recur i (+ j 1) (+ k 1))))))
                (recur (+ lo width width)))))
          (recur (* width 2) dst src))
        (map (fn [p] (nth p 1)) src)))))

; Structs, methods and interfaces

; (defstruct Name [field...]) defines a struct type. (Name val...) makes one,
; with a value for each field in order. (get s :field) and (put! s :field val)
; read and change its fields.
(defmacro defstruct [name fields]
  `(def ~name (make-type '~name '~fields)))

; (defmethod name [receiver Type param...] body...) is name's implementation
; for values of Type, picked by the type of the first argument when name is
; called. Any type can have methods, including the built-in ones (Int, Vector,
; ...).
(defmacro defmethod [name params & body]
  (let [ps (concat params)]
    `(add-method! '~name ~(nth ps 1) (fn [~(first ps) ~@(rest (rest ps))] ~@body))))

; (defgc [s Type] body...) runs body with s bound to each struct of Type made
; from now on, once nothing can reach it, to free what it holds (textures,
; files...). It runs once, at a safe point soon after a collection finds it.
; Underneath it's (set-gc! Type (fn [s] body...)).
(defmacro defgc [params & body]
  (let [ps (concat params)]
    `(set-gc! ~(nth ps 1) (fn [~(first ps)] ~@body))))

; (definterface Name method...) names a set of methods. A value satisfies an
; interface when its type has all of them, without having to say so.
(defmacro definterface [name & methods]
  `(def ~name '~(vec methods)))

(defn satisfies? [iface x]
  (let [t (type x) n (count iface)]
    (loop [i 0]
      (if (< i n)
        (if (find-method (nth iface i) t) (recur (+ i 1)) false)
        true))))
