  (println "- 7.5 2:" (- (+ i0 7.5) (+ i0 2)) (- (+ i0 7.5) i2) (- (+ i0 7.5) 2) (- f7 (+ i0 2)) (- f7 i2) (- f7 2) (- 7.5 (+ i0 2)) (- 7.5 i2) (- 7.5 2))
