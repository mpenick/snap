; vi: filetype=scheme

; Every binary op with every kind of operand (K literal, L local, S from the
; stack), with ints, floats and a mix. Ints take the variants' fast path,
; everything else falls back to the general handlers. (+ i0 x) puts x on the
; stack. Two literals (except for / and %) are worked out when compiling, so
; those columns check that folding agrees with the instructions.

(def f (fn [i7 i2 f7 f2 i0]
  (println "+ 7 2:" (+ (+ i0 7) (+ i0 2)) (+ (+ i0 7) i2) (+ (+ i0 7) 2) (+ i7 (+ i0 2)) (+ i7 i2) (+ i7 2) (+ 7 (+ i0 2)) (+ 7 i2) (+ 7 2))
  (println "+ 7.5 2.0:" (+ (+ i0 7.5) (+ i0 2.0)) (+ (+ i0 7.5) f2) (+ (+ i0 7.5) 2.0) (+ f7 (+ i0 2.0)) (+ f7 f2) (+ f7 2.0) (+ 7.5 (+ i0 2.0)) (+ 7.5 f2) (+ 7.5 2.0))
