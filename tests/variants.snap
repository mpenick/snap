  (println "if:" (if (< i2 i7) :lt :ge) (if (< f7 i2) :lt :ge) (if (= i7 7) :eq :ne) (if (= f2 2.0) :eq :ne))
  (let [x 0 y 0.0] (set! x (+ i7 i2)) (set! y (+ f7 i2)) (println "dest:" x y))
