; if, when and cond whose values aren't used (compiled without pushing nil)
(def log [])
(defn note [x] (push! log x))
(defn effects [n]
  (if (> n 0) (note :pos) nil)
  (if (< n 0) (note :neg) (note :not-neg))
  (when (= n 0) (note :zero) (note :still-zero))
  (cond (= n 1) (note :one) (= n 2) (note :two))
  (if (> n 0) (if (> n 1) (note :big) nil) nil)
  (begin (note :a) (when false (note :never)) (note :b))
  n)
(println (effects -1) (effects 0) (effects 1) (effects 2))
(println log)
; Loops whose body is a when, and statements in loops
(def seen [])
(loop [i 0] (when (< i 5) (when (= (% i 2) 0) (push! seen i)) (recur (+ i 1))))
(println seen)
(println (compile "(fn [] (when true (recur)) 1)"))

; Calls to globals
(defn three [a b c] [a b c])
(println (three 1 2 3) (count [1 2]) (max 1 5 2))
(defstruct P [x y])
(defmethod sum [p P] (+ (get p :x) (get p :y)))
(println (P 1 2) (sum (P 3 4)))
(defn later [] (redefined 1))
(defn redefined [x] (+ x 1))
(println (later))
(set! redefined (fn [x] (* x 10)))
(println (later))
(println (recover (fn [] (not-defined 1))))
(println (recover (fn [] (count 1 2))))
(println (recover (fn [] (three 1))))
; More than 255 arguments
(def many (fn [& xs] (count xs)))
(def src "(many")
(dotimes [i 300] (set! src (str src " " i)))
(println ((compile (str src ")"))))

; Float arithmetic and compares, with ints, immediate floats and boxed floats
(def big 1e300) ; Boxed
(defn fops [a b] [(+ a b) (- a b) (* a b) (/ a b) (< a b) (>= a b) (= a b)])
(println (fops 1.5 2) (fops 2 1.5) (fops 0.5 0.25))
(println (/ (+ big 2.0) big) (/ (* big 2) big) (/ (- 0.0 big) big) (- big big) (< big 1e301) (> big 2) (= big big))
(println (* big big) (/ 1 0.0))
(let [x 1.5 y 2] (println (+ x y) (* x x) (< x y) (- y x)))
(println (recover (fn [] (+ 1.5 "a"))) (recover (fn [] (< "a" 1.5))) (recover (fn [] (/ 1 0))))

; nth, count and get have their own instructions, which fall back to calling
; the global for anything but vectors, maps and structs, or once it's redefined
(def v [:a :b :c])
(def m {:x 1 "y" 2})
(def p (P 5 6))
(println (nth v 0) (nth v 2) (nth '(1 2 3) 1) (count v) (count m) (count '(1 2)) (count []))
(println (get m :x) (get m "y") (get m :z) (get m :z :default) (get p :x) (get p :y))
(println (recover (fn [] (nth v 3))) (recover (fn [] (nth v -1))) (recover (fn [] (nth v 1.0))))
(println (recover (fn [] (count 5))) (recover (fn [] (get p :z))) (recover (fn [] (get [1] 0))))
(println (map count [[1] [1 2] {}]) ((fn [nth] (nth 1 2)) +) (let [count 7] count))
(defn uses [] [(nth v 1) (count v) (get m :x)])
(println (uses))
(def orig-nth nth)
(def orig-count count)
(def orig-get get)
(set! nth (fn [c i] [:my-nth i]))
(set! count (fn [c] :my-count))
(set! get (fn [c k] [:my-get k]))
(println (uses))
(set! nth orig-nth)
(set! count orig-count)
(set! get orig-get)
(println (uses))
; int has its own instruction too, for immediate floats
(defn ints [x] (int x))
(println (ints 2.7) (ints -2.7) (ints 5) (recover (fn [] (ints 1e30))) (recover (fn [] (ints "a"))))
(def orig-int int)
(set! int (fn [x] :my-int))
(println (ints 2.7))
(set! int orig-int)
(println (ints 2.7))
(println (recover (fn [] (int 1e30))) (recover (fn [] (floor -1e300))) (recover (fn [] (int (/ 0.0 0.0)))) (int 4e18) (floor -4e18) (= (int -4.611686018427387904e18) (- -4611686018427387903 1)) (recover (fn [] (int 4.611686018427387904e18))))
; A C function that runs snap code (compile and macroexpand expanding a
; macro) can grow the stack under the caller, whose locals must still work
(defn deep [n] (if (= n 0) 0 (+ 1 (deep (- n 1)))))
(defmacro big [] (deep 20000))
(defn expands [a b]
  (let [x (+ a b)
        code (compile "(big)")
        y (macroexpand '(big))]
    (println a b x (code) y)))
(expands 1 2)
; An empty rest argument is nil, so (if opts ...) tells whether there are any
(def opt (fn [a & opts] (if opts (first opts) :none)))
(println (opt 1) (opt 1 2) (opt 1 false) (many) ((fn [& xs] xs)) ((fn [a & xs] (nil? xs)) 1))
; The same from C (map calls the function) and from a macro with no body
(defmacro body-or-nil [& body] (if body `(begin ~@body) nil))
(println (map (fn [& xs] xs) [1]) (map (fn [a & xs] xs) [1]) (body-or-nil) (body-or-nil 1 2) (macroexpand '(body-or-nil)))
; next is rest, but nil at the end, so a walk stops on (if xs ...)
(println (next '(1 2 3)) (next '(1)) (next '()) (next nil) (rest '(1)) (count nil))
(def total (fn [xs acc] (if xs (total (next xs) (+ acc (first xs))) acc)))
(println (total '(1 2 3) 0) (total nil 0) (recover (fn [] (next [1 2]))) (recover (fn [] (next))))
