; Destructuring: patterns in place of names in let, loop and fn

; Vectors, lists, nesting, and names after a pattern seeing its names
(let [[x z] [1 2] [a [b c]] [3 [4 5]] [p q] '(6 7) s (+ x z a b c p q)] (println x z a b c p q s))
; & rest (nil when there's none) and :as
(let [[a & more] [1 2 3] [b & none] [1] [c d :as all] [4 5] [e & r :as w] '(6 7 8)]
  (println a more b none c d all e r w))
; Maps and structs by :keys, with :as
(defstruct Pt [x y])
(let [{:keys [x y]} {:x 1 :y 2} {:keys [x2 missing] :as m} {:x2 3} {:keys [px py] :as pt} {:px 5 :py 6}]
  (println x y x2 missing m px py pt))
(let [{:keys [x y]} (Pt 7 8)] (println x y))
; Patterns in fn, defn and doseq; arity is one per pattern
(defn dist2 [[ax az] [bx bz]] (+ (* (- bx ax) (- bx ax)) (* (- bz az) (- bz az))))
(println (dist2 [0 0] [3 4]) ((fn [{:keys [a]} [b] & [c]] (list a b c)) {:a 1} [2] 3))
(doseq [[k v] [[:a 1] [:b 2]]] (println k v))
(println (recover (fn [] (dist2 [0 0]))))
; recur in a fn with patterns, and in a loop: one value per binding
(defn walk [[x & xs] acc] (if xs (recur xs (+ acc x)) (+ acc x)))
(println (walk [1 2 3 4] 0))
(println (loop [[a b] [0 1] i 0] (if (< i 10) (recur [b (+ a b)] (+ i 1)) a)))
; A loop's later values see its earlier names, patterns included
(println (loop [[a b] [1 2] c (+ a b) i 0] (if (< i 2) (recur [b c] (+ b c) (+ i 1)) [a b c])))
; Closures over destructured names
(let [[f g] (let [[a b] [10 20]] [(fn [] a) (fn [] b)])] (println (f) (g)))
; A local named nth or get doesn't break patterns
(let [nth 1 get 2 [a b] [3 4] {:keys [k]} {:k 5}] (println nth get a b k))
; Too short is nth's error; a non-vector is too
(println (recover (fn [] (let [[a b c] [1 2]] a))) (recover (fn [] (let [[a] nil] a))))
; nthnext
(println (nthnext [1 2 3] 1) (nthnext [1 2] 2) (nthnext '(1 2 3) 2) (nthnext nil 0) (nthnext [1] 5))
; Bad patterns
(println (compile "(let [[a :as] [1]] a)") (compile "(let [[a & ] [1]] a)") (compile "(let [{:k [a]} {}] a)"))
(println (compile "(let [[1] [1]] 1)") (compile "(let [{:keys [1]} {}] 1)") (compile "(let [[a & b c] [1]] a)"))
; Renaming: name (or pattern) on the left, the key to look up on the right
(let [{a0 :a w0 :w} {:a 1 :w 2} {a1 :a w1 :w} {:a 3 :w 4}] (println a0 w0 a1 w1))
(let [{[x z] :pos yaw :yaw {:keys [r]} :size} {:pos [1 2] :yaw 0.5 :size {:r 3}}] (println x z yaw r))
(let [{s "name" n 0} {"name" "pony" 0 :zero}] (println s n))
(let [{px :x :as p} (Pt 9 10)] (println px p))
; :or defaults, by the name bound: for :keys and renames, when the value is nil
(let [{:keys [wall floor] :or {wall :plaster}} {:floor :planks}] (println wall floor))
(let [{sw :swing th :thick :or {sw 1.6 th 0.15}} {:thick 0.3}] (println sw th))
(let [{:keys [open shut] :or {open true shut true}} {:open false :shut nil}] (println open shut))
(let [{:keys [x y] yaw :yaw :or {yaw 0.0} :as spec} {:x 1 :y 2}] (println x y yaw spec))
; Defaults are only evaluated when needed
(let [{:keys [a] :or {a (panic :boom "evaluated")}} {:a 1}] (println a))
(println (recover (fn [] (let [{:keys [a] :or {a (panic :boom "evaluated")}} {}] a))))
; Defaults can use names from outside the pattern, and work in fn params and loops
(let [d 7 {:keys [q] :or {q (* d 2)}} {}] (println q))
(defn door-size [{w :width h :height :or {w 1.0 h 2.0}}] [w h])
(println (door-size {}) (door-size {:width 3}))
(println (loop [{:keys [n acc] :or {acc 0}} {:n 3} i 0] (if (> n 0) (recur {:n (- n 1) :acc (+ acc n)} (+ i 1)) [acc i])))
; Bad :or and rename entries
(println (compile "(let [{:keys [a] :or {b 1}} {}] a)") (compile "(let [{[x] :p :or {x 1}} {}] x)") (compile "(let [{:keys [a] :or [a 1]} {}] a)"))
(println (compile "(let [{a b} {}] a)") (compile "(let [{1 :a} {}] 1)"))
