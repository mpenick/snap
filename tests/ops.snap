; Operators that aren't called are C functions that do the same
(println (reduce + 0 [1 2 3]) (reduce * 1 [1 2 3 4]) (reduce + 0 [1 2.5]))
(def ops [+ - * / % < <= > >= = not])
(println (map (fn [f] (if (= f not) (f false) (f 7 2))) ops))
(println (+ 1 2 3 4) ((fn [f] (f 1 2 3 4)) +) ((fn [f] (f 10 1 2)) -))
(println ((fn [f] (f 1 2 3)) <) ((fn [f] (f 1 3 2)) <) ((fn [f] (f :a :a)) =) ((fn [f] (f [1] [1])) =))
(println ((fn [f] (f 1.5 2)) *) ((fn [f] (f 1e300 1e300)) *) ((fn [f] (f 7.5 2)) %))
(println (recover (fn [] ((fn [f] (f 1 0)) /))) (recover (fn [] ((fn [f] (f 1)) /))) (recover (fn [] ((fn [f] (f 1 "a")) +))))
(println (compile "(map and [1])") (compile "(def x if)"))
; (- x) negates
(let [x 2.5 y 3] (println (- y) (- x) (- (- y)) (- 1.5) ((fn [f] (f 4)) -) (map - [1 -2.5])))
(println (recover (fn [] (- "a"))) (recover (fn [] ((fn [f] (f 1)) *))))
; (+ x) is x, if it's a number
(let [x 2.5 y 3] (println (+ y) (+ x) (+ (- y)) (+ 1.5) ((fn [f] (f 4)) +) (map + [1 -2.5])))
(println (recover (fn [] (+ "a"))) (recover (fn [] ((fn [f] (f "a")) +))) (compile "(+)"))
