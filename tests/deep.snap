; vi: filetype=scheme

; deep recursion grows the stack while upvalues are open
(def deep (fn [n]
  (let [[get (fn [] n)]]
    (if (= n 0) (get) (+ (get) (- (deep (- n 1)) (get)))))))
(println "deep:" (deep 5000))
(def boom (fn [n] (let [[f (fn [] n)]] (if (= n 0) (raise :oops "deep error") (boom (- n 1))))))
(boom 100)
