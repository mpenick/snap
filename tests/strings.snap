; vi: filetype=scheme

; Escapes in string literals, printed back escaped so they read the same
(println "a\nb" "tab\there" "q\"uote" "back\\slash" "ends in \\")
(println (= "\n" (str "\n")) (= "a\\" (str "a" "\\")))

; str joins strings, and other values as they print
(println (str) (str "a") (str "a" "" "b" "\n" "c"))
(println (str "a" 1 :k [1 "b"] nil))

; read-line returns nil at the end of input (stdin is empty in tests)
(println (read-line))

; print and println show a string as its text, anything else (strings inside
; it too) readably; repr is the readable form as a string
(println "plain" "two words" ["in" "a vector"] {:k "v"} :key 'sym 1.5 nil)
(print "tab\there" "quote\"d")
(println)
(println (repr "q") (repr "a\nb") (repr ["x" 1]) (repr :k) (repr 2))
(println (str "<" (repr "s") ">") (format "%s|%s" (repr "t") "t"))
(println (recover (fn [] (repr))) (recover (fn [] (repr 1 2))))
